# Dependencies
node_modules/

# Environment / secrets — never commit these
.env
.env.local
.env.*.local

# Build output
dist/
build/

# Admin-uploaded media is written at runtime and not source. Uploads are named
# `file-<timestamp>.<ext>`, so ignoring that prefix keeps the bundled seed
# images (amir.png, project covers) tracked alongside them.
server/uploads/file-*

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
